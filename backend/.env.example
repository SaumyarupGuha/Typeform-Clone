# SQLite file location. In production (Railway) point this at the mounted volume:
#   DATABASE_URL=sqlite:////data/typeform.db
DATABASE_URL=sqlite:///./typeform.db
# Origins allowed by CORS, comma-separated. The first one is also the base of public form links,
# e.g. FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
